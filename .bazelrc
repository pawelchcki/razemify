common --enable_platform_specific_config

# BuildBuddy: remote cache + build event stream are always on; the API key
# lives in user.bazelrc (gitignored, see user.bazelrc.example).
build --bes_backend=grpcs://remote.buildbuddy.io
build --bes_results_url=https://app.buildbuddy.io/invocation/
build --remote_cache=grpcs://remote.buildbuddy.io
build --remote_timeout=10m
build --remote_cache_compression
build --experimental_remote_cache_async
build --remote_download_toplevel
build --nolegacy_important_outputs
build --bes_upload_mode=fully_async

build:opt --compilation_mode=opt

# Remote execution is opt-in: `bazel build --config=remote ...`.
# Flutter host-bound actions are tagged no-remote-exec by rules_flutter and
# keep running locally even under this config.
build:remote --remote_executor=grpcs://remote.buildbuddy.io
build:remote --extra_execution_platforms=//platforms:rbe_linux_x86_64
build:remote --jobs=200
build:remote --remote_download_minimal
build:remote --experimental_remote_execution_keepalive

try-import %workspace%/user.bazelrc
