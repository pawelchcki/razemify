common --enable_platform_specific_config
# These values record acceptance of the corresponding Google Android SDK/NDK
# licenses and must match the hermetic toolchain versions in MODULE.bazel.
common --repo_env=ACCEPTED_ANDROID_SDK_LICENSE_VERSION=35
common --repo_env=ACCEPTED_ANDROID_NDK_LICENSE_VERSION=r28c
common --java_runtime_version=remotejdk_25
common --tool_java_language_version=25
common --tool_java_runtime_version=remotejdk_25

# Match Gradle's manifest merger: plugin library permissions must reach the APK.
common --merge_android_manifest_permissions

# BuildBuddy is opt-in so a fresh clone works without credentials. See
# user.bazelrc.example; --config=remote also enables this cache/BES config.
build:buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
build:buildbuddy --bes_results_url=https://app.buildbuddy.io/invocation/
build:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
build:buildbuddy --experimental_remote_downloader=grpcs://remote.buildbuddy.io
build:buildbuddy --experimental_remote_downloader_local_fallback
build:buildbuddy --remote_timeout=10m
build:buildbuddy --remote_cache_compression
build:buildbuddy --remote_cache_async
build:buildbuddy --remote_download_toplevel
build:buildbuddy --nolegacy_important_outputs
build:buildbuddy --bes_upload_mode=fully_async

# Publicly viewable BuildBuddy invocations and repository metadata
build:buildbuddy --build_metadata=VISIBILITY=PUBLIC
build:buildbuddy --build_metadata=REPO_URL=https://github.com/pawelchcki/razemify

# CI configuration extending BuildBuddy
build:ci --config=buildbuddy
build:ci --build_metadata=ROLE=CI

# //:clippy is a gate, so warnings must fail it -- the equivalent of
# `cargo clippy -- -D warnings`.
build --@rules_rs_internal//rust/settings:clippy_flag=-Dwarnings

build:opt --compilation_mode=opt

# Remote execution is opt-in: `bazel build --config=remote ...`. Android and
# Flutter actions use declared toolchains and are eligible for remote execution.
build:remote --remote_executor=grpcs://remote.buildbuddy.io
build:remote --config=buildbuddy
build:remote --extra_execution_platforms=//platforms:rbe_linux_x86_64
build:remote --jobs=200
build:remote --remote_download_minimal
build:remote --experimental_remote_execution_keepalive

try-import %workspace%/user.bazelrc
