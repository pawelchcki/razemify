module(
    name = "razemify",
    version = "0.1.0",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "rules_rs", version = "0.0.107")
bazel_dep(name = "llvm", version = "0.8.18")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "aws-lc", version = "5.1.0.bcr.2")

# Bazel-native Flutter and Android build stack. Non-registry overrides are only
# honored in the root module, so consumers must repeat both fork overrides (see
# //bazel:README.md).
bazel_dep(name = "rules_flutter", version = "0.0.0")
bazel_dep(name = "rules_dart", version = "0.4.9")

bazel_dep(name = "hermetic_android_toolchains", version = "0.0.0", dev_dependency = True)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "protobuf", version = "34.0.bcr.1")
bazel_dep(name = "rules_android", version = "0.7.2")
bazel_dep(name = "rules_android_ndk", version = "0.1.5")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_java", version = "9.6.1")
bazel_dep(name = "rules_jvm_external", version = "7.0")
bazel_dep(name = "rules_kotlin", version = "2.3.20")
bazel_dep(name = "rules_go", version = "0.62.0")

archive_override(
    module_name = "rules_flutter",
    sha256 = "7e7c7bc1b12a636804227b820abceb8e3973af00ae41bfaa5e04edd6ab742b9b",
    strip_prefix = "rules_flutter-e81074d44674a2a295452931ddb6ab654ba089fc",
    urls = ["https://github.com/pawelchcki/rules_flutter/archive/e81074d44674a2a295452931ddb6ab654ba089fc.tar.gz"],
)

# Deterministic Dart compilation fix required by the pinned rules_flutter
# revision until the corresponding rules_dart change is released.
archive_override(
    module_name = "rules_dart",
    sha256 = "44b144bc5a4cce234160122a9f556a91c6b9a310bd262a3eacdc18625138b8ca",
    strip_prefix = "rules_dart-6cd2d1146614a6c982e492b2e558debf6f41d450",
    urls = ["https://github.com/aran/rules_dart/archive/6cd2d1146614a6c982e492b2e558debf6f41d450.tar.gz"],
)

# Downloaded Android SDK/NDK repositories, pinned because this module is not in
# the BCR. This revision exposes repositories that can replace the local-only
# repositories created by rules_android and rules_android_ndk.
archive_override(
    module_name = "hermetic_android_toolchains",
    sha256 = "7fce0f58bedeed8a5e2a00a2beae49c120784c4354c238b2604bf2aedcbfaa40",
    strip_prefix = "hermetic_android_toolchains-e723dd55401eaae04019e546e2f9bf78d0f33acf",
    urls = ["https://github.com/keith/hermetic_android_toolchains/archive/e723dd55401eaae04019e546e2f9bf78d0f33acf.tar.gz"],
)

# hermetic_android_toolchains tracks rules_android 0.7.3, but its repository
# replacement interface is compatible with the 0.7.2 stack pinned by the
# rules_flutter revision used here.
single_version_override(
    module_name = "rules_android",
    version = "0.7.2",
)

# rules_android_ndk 0.1.5 is not yet available from the BCR.
archive_override(
    module_name = "rules_android_ndk",
    sha256 = "07e7a2777113bb3d0a432265d1c78cfaa140a5bc4c82be4c8cd988b34382ec90",
    strip_prefix = "rules_android_ndk-0.1.5",
    urls = ["https://github.com/bazelbuild/rules_android_ndk/releases/download/v0.1.5/rules_android_ndk-v0.1.5.tar.gz"],
)

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2021",
    version = "1.97.1",
)
use_repo(toolchains, "default_rust_toolchains")

rules_rs_bindgen = use_extension("@rules_rs//rs:rules_rust_bindgen.bzl", "rules_rust_bindgen")
use_repo(rules_rs_bindgen, rules_rs_bindgen = "rules_rust_bindgen")

register_toolchains(
    "@default_rust_toolchains//...",
    "@llvm//toolchain:all",
    "@rules_rs_bindgen//:all",
)

# rules_rs is implemented on a patched compatibility repository. Keep that
# implementation detail behind a rules_rs-owned apparent name; Razemify's Rust
# build rules are loaded exclusively from @rules_rs. The local patch fixes
# response-file substitutions while rules_rs bootstraps its process wrapper.
rules_rs_internal = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
rules_rs_internal.patch(
    patches = ["//bazel:rules_rs_bootstrap_determinism.patch"],
    strip = 1,
)
use_repo(rules_rs_internal, rules_rs_internal = "rules_rust")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin",
        "wasm32-unknown-unknown",
        "aarch64-linux-android",
        "x86_64-linux-android",
    ],
)

# razemify-core uses ort with `load-dynamic`, which turns on
# ort-sys/disable-linking: the build script would exit without doing anything,
# so skip compiling it entirely. The ONNX Runtime dylib is provided at runtime
# via ORT_DYLIB_PATH (see //third_party/onnxruntime).
crate.annotation(
    crate = "ort-sys",
    gen_build_script = "off",
)

# rav1e's build.rs uses the `built` crate, which records the absolute compiler
# path and may record time/parallelism. Override its informational compiler
# fields and use the standard reproducible-build epoch.
crate.annotation(
    build_script_env = {
        "BUILT_OVERRIDE_rav1e_RUSTC": "rustc",
        "BUILT_OVERRIDE_rav1e_RUSTC_VERSION": "rustc 1.97.1",
        "BUILT_OVERRIDE_rav1e_RUSTDOC": "rustdoc",
        "BUILT_OVERRIDE_rav1e_RUSTDOC_VERSION": "rustdoc 1.97.1",
        "SOURCE_DATE_EPOCH": "0",
    },
    crate = "rav1e",
)

# Replace aws-lc-sys's host CMake build with rules_rs's declared Bazel target.
# Besides being hermetic, this avoids object metadata tied to the output base.
crate.annotation(
    crate = "aws-lc-rs",
    gen_build_script = "off",
)
crate.annotation(
    additive_build_file = "@rules_rs//3rd_party/aws-lc-sys:additive.BUILD.bazel",
    crate = "aws-lc-sys",
    extra_aliased_targets = {"aws_lc_sys_build_info": "aws_lc_sys_build_info"},
    gen_build_script = "off",
    rustc_flags = ["--cfg=use_bindgen_pregenerated"],
    deps = ["@crates//:aws_lc_sys_build_info"],
)

inject_repo(crate, "aws-lc")

# Our own wasm-bindgen CLI universe: the CLI's schema version must match the
# wasm-bindgen crate version in //:Cargo.lock, and the toolchain bundled with
# rules_rs lags behind. Keep third_party/wasm_bindgen/Cargo.toml in lockstep
# with the workspace's wasm-bindgen version.
crate.from_cargo(
    name = "wbd",
    cargo_lock = "//third_party/wasm_bindgen:Cargo.lock",
    cargo_toml = "//third_party/wasm_bindgen:Cargo.toml",
    platform_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin",
        "wasm32-unknown-unknown",
    ],
)
crate.annotation(
    crate = "wasm-bindgen-cli",
    gen_binaries = ["wasm-bindgen"],
    repositories = ["wbd"],
)
# rustix's compiler feature probes leave their temporary rmeta in OUT_DIR.
# The file is not consumed, and its metadata contains the output-base path.
crate.annotation(
    crate = "rustix",
    patch_args = ["-p1"],
    patches = ["//bazel:rustix_determinism.patch"],
    repositories = ["wbd"],
)
use_repo(crate, "crates", "wbd")

wasm_bindgen = use_extension("@rules_rs//rs:rules_rust_wasm_bindgen.bzl", "rules_rust_wasm_bindgen")
use_repo(wasm_bindgen, rules_rs_wasm_bindgen = "rules_rust_wasm_bindgen")

# Ours first: toolchain resolution picks the first registered match.
register_toolchains(
    "//third_party/wasm_bindgen:wasm_bindgen_toolchain",
    "@rules_rs_wasm_bindgen//:default_wasm_bindgen_toolchain",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# ONNX Runtime version must match what the resolved ort-sys crate pins
# (build/download/dist.tsv in the ort-sys sources): ort-sys 2.0.0-rc.13 -> 1.28.0.
http_archive(
    name = "onnxruntime_linux_x64",
    build_file = "//third_party/onnxruntime:onnxruntime.BUILD",
    sha256 = "a3e1b79d7bb1bf09696ce675f49e4064e6c81f6202b8225624fff0e93f8d6407",
    strip_prefix = "onnxruntime-linux-x64-1.28.0",
    url = "https://github.com/microsoft/onnxruntime/releases/download/v1.28.0/onnxruntime-linux-x64-1.28.0.tgz",
)

http_archive(
    name = "onnxruntime_linux_aarch64",
    build_file = "//third_party/onnxruntime:onnxruntime.BUILD",
    sha256 = "e15ff8b5d85afe6c144d7c6fd432254bf76a219daaf17658087d6ecb3e8f0bb",
    strip_prefix = "onnxruntime-linux-aarch64-1.28.0",
    url = "https://github.com/microsoft/onnxruntime/releases/download/v1.28.0/onnxruntime-linux-aarch64-1.28.0.tgz",
)

http_archive(
    name = "onnxruntime_osx_arm64",
    build_file = "//third_party/onnxruntime:onnxruntime.BUILD",
    sha256 = "1268b359718099bde2cedb55787f182a130067bc4f31e8c88478c445b850d3d8",
    strip_prefix = "onnxruntime-osx-arm64-1.28.0",
    url = "https://github.com/microsoft/onnxruntime/releases/download/v1.28.0/onnxruntime-osx-arm64-1.28.0.tgz",
)

# Flutter SDK and pub dependency hubs.
flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.44.1")

# Use the example application's lock as the single Bazel hub. It contains the
# plugin's full dependency closure and avoids introducing two copies of Flutter
# SDK packages into the same application graph.
flutter.pub(
    name = "flutter_razemify_deps",
    lock = "//flutter_razemify/example:pubspec.lock",
)
flutter.plugin_overlays(
    roots = ["//bazel/flutter_plugin_overlays:BUILD.bazel"],
)
use_repo(
    flutter,
    "flutter_android_engine_arm64",
    "flutter_android_engine_x64",
    "flutter_razemify_deps",
    "flutter_toolchains",
)

register_toolchains("@flutter_toolchains//:all")

# rules_android's transitive Go SDK is too old for its current dependencies.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.2")

# rules_android still supplies its Bazel Android tools repository. The SDK and
# NDK below are downloaded separately as versioned, checksummed archives.
remote_android_extensions = use_extension(
    "@rules_android//bzlmod_extensions:android_extensions.bzl",
    "remote_android_tools_extensions",
)
use_repo(remote_android_extensions, "android_tools")

android = use_extension(
    "@hermetic_android_toolchains//:extensions.bzl",
    "android",
    dev_dependency = True,
)
android.sdk(
    api_level = "35",
    build_tools_version = "35.0.0",
    version = "35",
)
android.ndk(version = "r28c")
use_repo(android, "androidndk", "androidsdk")

# Redirect the repositories expected internally by rules_android and
# rules_android_ndk to the hermetic repositories above.
rules_android_sdk = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
    dev_dependency = True,
)

override_repo(rules_android_sdk, "androidsdk")

rules_android_ndk = use_extension(
    "@rules_android_ndk//:extension.bzl",
    "android_ndk_repository_extension",
    dev_dependency = True,
)

override_repo(rules_android_ndk, "androidndk")

register_toolchains(
    "@androidndk//:all",
    "@androidsdk//:all",
    dev_dependency = True,
)

# Root-owned Maven configuration from rules_flutter's Android e2e workspace.
