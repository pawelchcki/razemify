load(
    "//bazel:defs.bzl",
    "flutter_android_app",
    "flutter_application",
    "flutter_library",
)

exports_files(["test/widget_test.dart"])

flutter_library(
    name = "example_library",
    package_name = "flutter_razemify_example",
    srcs = ["lib/main.dart"],
    visibility = ["//bazel:__pkg__"],
    deps = [
        "//flutter_razemify",
        "@flutter_razemify_deps//:flutter",
        "@flutter_razemify_deps//:image_picker",
        "@rules_flutter//flutter:material_icons",
    ],
)

flutter_application(
    name = "example_flutter",
    main = "//:lib/flutter_razemify_example_main.dart",
    package_name = "flutter_razemify_example",
    srcs = ["lib/main.dart"],
    deps = [
        "//flutter_razemify",
        "@flutter_razemify_deps//:flutter",
        "@flutter_razemify_deps//:image_picker",
        "@rules_flutter//flutter:material_icons",
    ],
)

flutter_android_app(
    name = "example_arm64",
    android_abi = "arm64",
    application = ":example_flutter",
    app_name = "Razemify Example",
    package_name = "com.example.flutter_razemify_example",
    pub_hub_name = "flutter_razemify_deps",
)

flutter_android_app(
    name = "example_x64",
    android_abi = "x64",
    application = ":example_flutter",
    app_name = "Razemify Example",
    package_name = "com.example.flutter_razemify_example",
    pub_hub_name = "flutter_razemify_deps",
)

# integration_test/ needs a real device or emulator and remains outside Bazel.
test_suite(
    name = "widget_test",
    tests = ["//bazel:flutter_razemify_widget_test"],
)
