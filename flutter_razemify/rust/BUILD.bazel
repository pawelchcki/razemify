load("@rules_rs//rs:rust_shared_library.bzl", "rust_shared_library")
load("@rules_rs//rs:rust_static_library.bzl", "rust_static_library")

# rules_flutter's Android application transition selects the ABI-specific
# Android platform and preserves Bazel's compilation mode for this dependency.
rust_shared_library(
    name = "flutter_razemify_shared",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "flutter_razemify",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = ["//razemify-core:razemify_core_flutter"],
)

rust_static_library(
    name = "flutter_razemify_static",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "flutter_razemify",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = ["//razemify-core:razemify_core_flutter"],
)
