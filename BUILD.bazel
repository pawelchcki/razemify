load("@rules_rust//rust:defs.bzl", "rust_clippy", "rustfmt_test")

exports_files(
    [
        "Cargo.toml",
        "Cargo.lock",
    ],
    visibility = ["//visibility:public"],
)

# Stable dependency-facing facade. Consumers should use these labels instead
# of reaching into the repository's internal package layout.
alias(
    name = "flutter_razemify",
    actual = "//flutter_razemify",
    visibility = ["//visibility:public"],
)

alias(
    name = "flutter_razemify_android_debug",
    actual = "//flutter_razemify:flutter_razemify_android_debug",
    visibility = ["//visibility:public"],
)

alias(
    name = "flutter_razemify_android_release",
    actual = "//flutter_razemify:flutter_razemify_android_release",
    visibility = ["//visibility:public"],
)

# Rust lint and format gates, so CI needs no cargo/rustup toolchain.
# Equivalent to `cargo clippy --workspace -- -D warnings` and
# `cargo fmt --all --check`; see .bazelrc for the deny-warnings flag.
_RUST_TARGETS = [
    "//flutter_razemify/rust:flutter_razemify_static",
    "//razemify-cli",
    "//razemify-core:razemify_core",
    "//razemify-core:razemify_core_flutter",
    "//razemify-core:razemify_core_rembg",
    "//razemify-wasm:razemify_wasm_cdylib",
    "//xtask",
]

_RUST_CLIPPY_TARGETS = _RUST_TARGETS + [
    "//razemify-core:razemify_core_rembg_test",
    "//razemify-core:razemify_core_test",
]

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = _RUST_CLIPPY_TARGETS,
)

rustfmt_test(
    name = "rustfmt",
    targets = _RUST_TARGETS,
)
