load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

# CLI version matches the wasm-bindgen crate in //:Cargo.lock; registered
# before rules_rs's bundled toolchain in MODULE.bazel so it wins.
rust_wasm_bindgen_toolchain(
    name = "wasm_bindgen_toolchain_impl",
    tags = ["manual"],
    wasm_bindgen_cli = "@wbd//:wasm-bindgen-cli__wasm-bindgen",
)

toolchain(
    name = "wasm_bindgen_toolchain",
    toolchain = ":wasm_bindgen_toolchain_impl",
    toolchain_type = "@rules_rust_wasm_bindgen//:toolchain_type",
)
