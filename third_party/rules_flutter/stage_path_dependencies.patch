diff --git a/flutter/private/flutter_actions.bzl b/flutter/private/flutter_actions.bzl
--- a/flutter/private/flutter_actions.bzl
+++ b/flutter/private/flutter_actions.bzl
@@ -1311,6 +1311,27 @@ export PUB_CACHE="$RW_PUB_CACHE"
 export PUB_CACHE_DIR_ABS="$RW_PUB_CACHE"
 export PUB_CACHE_ABS="$RW_PUB_CACHE"
 
+# Path dependencies are staged under the assembled cache because their source
+# location is outside this package's prepared workspace. Point the mutable
+# pubspec copy at those staged packages before asking pub to resolve it.
+awk -v cache="$RW_PUB_CACHE/path" '
+BEGIN { section = 0; package = "" }
+/^[^[:space:]#][^:]*:/ {
+    section = ($0 ~ /^(dependencies|dev_dependencies|dependency_overrides):/);
+    package = "";
+}
+section && /^  [A-Za-z0-9_-]+:[[:space:]]*$/ {
+    package = $0;
+    sub(/^  /, "", package);
+    sub(/:[[:space:]]*$/, "", package);
+}
+section && package != "" && /^    path:[[:space:]]*/ {
+    print "    path: " cache "/" package;
+    next;
+}
+{ print }' pubspec.yaml > pubspec.yaml.bazel.tmp
+mv pubspec.yaml.bazel.tmp pubspec.yaml
+
 echo "Running flutter pub get --offline to regenerate plugin tooling..."
 if ! "$FLUTTER_BIN_ABS" --suppress-analytics --no-version-check pub get --offline; then
     echo "✗ FATAL ERROR: flutter pub get --offline failed" >&2
@@ -1503,8 +1524,12 @@ FAST_STAGING="{fast_staging}"
 _stage_tree "$SOURCE_WORKSPACE_ABS" "$BUILD_WORKSPACE_TMP" "$FAST_STAGING"
 if [ "$FAST_STAGING" = "1" ]; then
     _make_dirs_writable "$BUILD_WORKSPACE_TMP"
-    _unshare_file "$BUILD_WORKSPACE_TMP/pubspec.yaml"
-    _unshare_file "$BUILD_WORKSPACE_TMP/pubspec.lock"
+    # Flutter's project migrators may rewrite any source file. Break every
+    # staging hardlink before invoking Flutter so those writes neither fail
+    # nor mutate Bazel's input tree.
+    while IFS= read -r FILE; do
+        _unshare_file "$FILE"
+    done < <(find "$BUILD_WORKSPACE_TMP" -type f -print)
 else
     chmod -R u+rwX "$BUILD_WORKSPACE_TMP"
 fi
