load("@rules_rs//rs:rust_shared_library.bzl", "rust_shared_library")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen")

rust_shared_library(
    name = "razemify_wasm_cdylib",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["console_error_panic_hook"],
    edition = "2021",
    deps = [
        "//razemify-core:razemify_core",
        "@crates//:console_error_panic_hook",
        "@crates//:image",
        "@crates//:js-sys",
        "@crates//:wasm-bindgen",
        "@crates//:web-sys",
    ],
)

# Applies the wasm32-unknown-unknown transition itself and runs wasm-bindgen,
# producing the JS glue + .wasm as wasm-pack --target web would.
rust_wasm_bindgen(
    name = "razemify_wasm",
    target = "web",
    visibility = ["//visibility:public"],
    wasm_file = ":razemify_wasm_cdylib",
)
